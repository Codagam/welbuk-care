# Welbuk Care — public runtime config (inlined by Expo at build time).
# Copy to `.env` and set for your environment. A physical device cannot reach
# `localhost` — use your machine's LAN IP or the staging origin.

# Welbuk Practice API origin (no trailing slash)
EXPO_PUBLIC_PRACTICE_URL=http://localhost:3005

# Realtime notification server
EXPO_PUBLIC_WS_URL=https://ws.welbuk.com

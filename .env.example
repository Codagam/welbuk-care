# Welbuk Care — runtime config template. Copy to `.env` for local development.
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time. They are
# PUBLIC — never put secrets, tokens, or API keys here.
#
# For `preview` / `production` builds, set these as EAS environment variables
# (Project → Environment Variables) with https:// origins, NOT via this file.

# Welbuk Practice API origin, no trailing slash.
# Dev: your machine's LAN IP (a device cannot reach localhost), e.g.
#   http://192.168.1.5:3005
# Prod: https://<production practice host>
EXPO_PUBLIC_PRACTICE_URL=

# Realtime notification server (wss upgrade). e.g. https://ws.welbuk.com
EXPO_PUBLIC_WS_URL=

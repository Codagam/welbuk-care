{
  "expo": {
    "name": "Welbuk Care",
    "slug": "welbuk-care",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "welbukcare",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "backgroundColor": "#FD006A",
      "barStyle": "light-content",
      "translucent": true
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FD006A",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.codagam_gobi.welbukcare"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FD006A",
          "image": "./assets/images/icon.png",
          "imageWidth": 128
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "expo-status-bar",
        {
          "style": "light",
          "hidden": false
        }
      ],
      "expo-web-browser",
      "expo-asset",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "40f727fc-b284-4a57-b371-86af2ff1875d"
      }
    }
  }
}

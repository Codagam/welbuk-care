{
  "expo": {
    "name": "Welbuk Care",
    "slug": "welbuk-care",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "welbukcare",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "androidStatusBar": {
      "backgroundColor": "#FD006A",
      "barStyle": "light-content",
      "translucent": true
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "practice.welbuk.com",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FD006A",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FD006A",
          "image": "./assets/images/icon.png",
          "imageWidth": 128
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Welbuk Care uses the microphone to record consultation audio that a clinician attaches to a patient's visit.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "expo-status-bar",
        {
          "style": "light",
          "hidden": false
        }
      ],
      "expo-web-browser",
      "expo-asset",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-status-bar": {
        "style": "light",
        "hidden": false
      },
      "eas": {
        "projectId": "40f727fc-b284-4a57-b371-86af2ff1875d"
      }
    }
  }
}
